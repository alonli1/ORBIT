        RowBox[{"Coefficient", "[", 
         RowBox[{"expr", ",", "lam", ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"expr", "=", 
        RowBox[{"expr", "/.", " ", 
         RowBox[{
          RowBox[{"HoldPattern", "[", 
           RowBox[{"dh", "[", 
            RowBox[{"x_", ",", "y_"}], "]"}], "]"}], ":>", 
          RowBox[{"delta", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"canonExpr", "[", "expr", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fpShifts", "=", 
    RowBox[{"ShiftFromRedef", "/@", "deltaBasis"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Fierz-Pauli cubic shifts =\>\"", "]"}], ";"}], "\n", 
 RowBox[{"fpShifts", "//", "TableForm"}], "\[IndentingNewLine]", 
 RowBox[{"FreeQ", "[", 
  RowBox[{"fpShifts", ",", 
   RowBox[{
    RowBox[{"PD", "[", "_", "]"}], "[", "lam", "]"}]}], "]"}], "\n", 
 RowBox[{"FreeQ", "[", 
  RowBox[{"fpShifts", ",", "lam"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cases", "[", 
   RowBox[{"fpShifts", ",", 
    RowBox[{"_", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Not", "@*", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"PD", "[", "_", "]"}], "[", "lam", "]"}]}], "]"}]}], "&"}],
       ")"}]}], ",", "Infinity"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Projection", " ", "into", " ", "the", " ", "same", " ", "IBP", " ", 
    "quotient"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ProjectModuloIBP", "[", 
     RowBox[{"expr_", ",", "basis_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ans", ",", "eq", ",", "sol", ",", "qvars", ",", "coeffs"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"ans", "=", 
        RowBox[{"MakeAnsatz", "[", 
         RowBox[{"basis", ",", 
          RowBox[{"ConstantPrefix", "->", "q"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qvars", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Symbol", "[", 
           RowBox[{"\"\<q\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eq", "=", 
        RowBox[{"canonExpr", "@", 
         RowBox[{
          RowBox[{"VarD", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{
              RowBox[{"-", "u"}], ",", 
              RowBox[{"-", "v"}]}], "]"}], ",", "PD"}], "]"}], "[", 
          RowBox[{"ans", "-", "expr"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"SolveConstants", "[", 
         RowBox[{"eq", "==", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeffs", "=", 
        RowBox[{"qvars", "/.", " ", 
         RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"canonExpr", "[", 
          RowBox[{"ans", "/.", " ", 
           RowBox[{"First", "[", "sol", "]"}]}], "]"}], ",", "coeffs", ",", 
         "sol"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projFP", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ProjectModuloIBP", "[", 
       RowBox[{"#", ",", "basis14"}], "]"}], "&"}], "/@", "fpShifts"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"fpImages", "=", 
   RowBox[{"projFP", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fpVecs", "=", 
    RowBox[{"projFP", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Projected FP image vectors in basis14 coordinates =\>\"",
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fpVecs", "//", "MatrixForm"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"fpRank", "=", 
   RowBox[{"MatrixRank", "[", "fpVecs", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pivotFP", "=", 
   RowBox[{"PivotColumns", "[", "fpVecs", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"basisFP", "=", 
    RowBox[{"Delete", "[", 
     RowBox[{"basis14", ",", 
      RowBox[{"List", "/@", 
       RowBox[{"Sort", "[", "pivotFP", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<FP field-redefinition rank = \>\"", ",", "fpRank"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<pivotFP = \>\"", ",", "pivotFP"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Final cubic derivative dimension modulo IBP + FP \
redefinitions = \>\"", ",", 
    RowBox[{"Length", "[", "basisFP", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<basisFP =\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"basisFP", "//", "TableForm"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "Summary", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"summary", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<RawDim5DerivativeCount\>\"", "->", "rawCount"}], ",", 
      RowBox[{"\"\<IBPRelationCount\>\"", "->", 
       RowBox[{"Length", "[", "relMat", "]"}]}], ",", 
      RowBox[{"\"\<DimModuloIBP\>\"", "->", 
       RowBox[{"Length", "[", "basis14", "]"}]}], ",", 
      RowBox[{"\"\<FPFieldRedefRank\>\"", "->", "fpRank"}], ",", 
      RowBox[{"\"\<DimModuloIBPAndFP\>\"", "->", 
       RowBox[{"Length", "[", "basisFP", "]"}]}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<summary = \>\"", ",", "summary"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.98182129587339*^9, 3.98182129587339*^9}, {
