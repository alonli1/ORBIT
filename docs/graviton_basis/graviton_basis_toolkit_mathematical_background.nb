          BaseStyle->"Graphics"]}, {
         DiskBox[{1.3333333422649658`, 1.9999999821367354`}, {0.22, 0.1}], 
         InsetBox["\<\"Quotient by\\nredefinition image\"\>", {1.3333333422649658, 1.9999999821367354},
          
          BaseStyle->"Graphics"]}, {
         DiskBox[{2.3333333422649654`, 1.9999999553418384`}, {0.22, 0.1}], 
