         InsetBox["\<\"Quadratic sector\\nnh = 2\"\>", {-0.6666666845299312, 1.0000000357265297},
          
          BaseStyle->"Graphics"]}, {
         DiskBox[{0.333333342264966, 2.0000000089316323`}, {0.22, 0.1}], 
