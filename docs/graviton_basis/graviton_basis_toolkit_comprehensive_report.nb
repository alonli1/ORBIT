        ArrowBox[{{0., 1.}, {0., 0.}}, 0.26]}, 
       {RGBColor[0.78, 0.8625, 0.9299999999999999], EdgeForm[{GrayLevel[0.7], 
        Opacity[0.7]}], {DiskBox[{0., 6.}, {0.26, 0.11}], 
         InsetBox["\<\"Ordered derivative\\npartitions\"\>", {0., 6.},
          BaseStyle->"Graphics"]}, {DiskBox[{0., 5.}, {0.26, 0.11}], 
         InsetBox["\<\"All contractions\\nand canonicalization\"\>", {0., 5.},
          
          BaseStyle->"Graphics"]}, {DiskBox[{0., 4.}, {0.26, 0.11}], 
         InsetBox["\<\"Raw scalar basis\"\>", {0., 4.},
